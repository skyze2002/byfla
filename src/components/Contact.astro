---
import { contact, form, t, es } from '../data/site';
import Scribble from './Scribble.astro';

const links = [
	{ label: 'Email', value: contact.email, href: `mailto:${contact.email}`, tone: 'butter', r: -3 },
	{ label: 'WhatsApp', value: contact.phoneDisplay, href: contact.whatsapp, tone: 'pink', r: 2, external: true },
	{ label: 'Instagram', value: contact.instagram.handle, href: contact.instagram.url, tone: 'sky', r: -1.5, external: true },
	{ label: 'TikTok', value: contact.tiktok.handle, href: contact.tiktok.url, tone: 'paper', r: 3, external: true },
];

const fields = [
	{ id: 'nombre', type: 'text', label: 'form_name', ph: 'ph_name', auto: 'name' },
	{ id: 'email', type: 'email', label: 'form_email', ph: 'ph_email', auto: 'email' },
	{ id: 'empresa', type: 'text', label: 'form_company', ph: 'ph_company', auto: 'organization' },
];

const selects = [
	{ id: 'tipo', label: 'form_type', values: form.typeValues, options: t.es.content_type, key: 'content_type' },
	{ id: 'presupuesto', label: 'form_budget', values: form.budgetValues, options: t.es.budget_range, key: 'budget_range' },
];
---

<section id="contacto" class="section contact">
	<span class="contact__bg" aria-hidden="true" data-parallax="0.18"><span data-i18n="contact_hi">{es('contact_hi')}</span></span>

	<div class="container contact__grid">
		<div class="contact__info">
			<p class="eyebrow" data-reveal="up"><span data-i18n="contact_eyebrow">{es('contact_eyebrow')}</span></p>
			<h2 class="h-section contact__title" data-reveal="up">
				<span data-i18n="contact_h1">{es('contact_h1')}</span>{' '}
				<em data-i18n="contact_h2">{es('contact_h2')}</em>{' '}
				<Scribble k="contact_h3" d="0.5s" />
			</h2>
			<p class="contact__tagline" data-reveal="up" data-i18n="contact_tagline">{es('contact_tagline')}</p>

			<ul class="contact__links" data-stagger="0.08">
				{
					links.map((l) => (
						<li data-reveal="pop">
							<a
								class={`sticker sticker--${l.tone} clink`}
								style={`--r:${l.r}deg`}
								href={l.href}
								target={l.external ? '_blank' : undefined}
								rel={l.external ? 'noopener' : undefined}
							>
								<span class="clink__label">{l.label}</span>
								<span class="clink__value">{l.value}</span>
							</a>
						</li>
					))
				}
			</ul>

			<p class="contact__avail" data-reveal="up" data-i18n="contact_avail">{es('contact_avail')}</p>
		</div>

		<div class="fcard" data-form-card data-reveal="tilt" style="--r:1.2deg;--tilt:7deg">
			<span class="tape" aria-hidden="true"></span>

			<form
				id="contact-form"
				class="fcard__form"
				action={form.endpoint}
				method="POST"
				novalidate
				data-i18n-aria="contact_form_label"
				aria-label={es('contact_form_label')}
			>
				<input type="hidden" name="access_key" value={form.accessKey} />
				<input type="hidden" name="subject" value={form.subject} />
				<input type="checkbox" name="botcheck" class="fcard__bot" tabindex="-1" autocomplete="off" />

				{
					fields.map((f) => (
						<div class="field">
							<input
								class="field__input"
								id={f.id}
								name={f.id}
								type={f.type}
								placeholder={es(f.ph)}
								data-i18n-placeholder={f.ph}
								autocomplete={f.auto}
								required
							/>
							<label class="field__label" for={f.id}>
								<span data-i18n={f.label}>{es(f.label)}</span> *
							</label>
						</div>
					))
				}

				<div class="fcard__row">
					{
						selects.map((s) => (
							<div class="field field--select">
								<select class="field__input" id={s.id} name={s.id} data-i18n-select={s.key}>
									{s.values.map((v, i) => (
										<option value={v} disabled={i === 0} selected={i === 0}>
											{s.options[i]}
										</option>
									))}
								</select>
								<label class="field__label" for={s.id} data-i18n={s.label}>
									{es(s.label)}
								</label>
							</div>
						))
					}
				</div>

				<div class="field">
					<textarea
						class="field__input"
						id="mensaje"
						name="mensaje"
						rows="5"
						placeholder={es('ph_message')}
						data-i18n-placeholder="ph_message"
						required></textarea>
					<label class="field__label" for="mensaje"><span data-i18n="form_message">{es('form_message')}</span> *</label>
				</div>

				<p class="fcard__status" data-form-status role="alert" hidden></p>

				<button class="btn fcard__submit" type="submit">
					<span data-i18n="contact_submit">{es('contact_submit')}</span>
					<span class="btn__arrow" aria-hidden="true">→</span>
				</button>
				<p class="fcard__privacy" data-i18n="contact_privacy">{es('contact_privacy')}</p>
			</form>

			<div class="fcard__success" data-form-success tabindex="-1" hidden>
				<span class="fcard__check" data-success-check aria-hidden="true">✓</span>
				<h3 class="fcard__success-title" data-i18n="contact_success_title">{es('contact_success_title')}</h3>
				<p data-i18n="contact_success_desc">{es('contact_success_desc')}</p>
				<a class="btn btn--butter" href={contact.whatsapp} target="_blank" rel="noopener">
					<span data-i18n="contact_whatsapp">{es('contact_whatsapp')}</span>
					<span class="btn__arrow" aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		background: var(--cherry);
		color: var(--cream);
		overflow: hidden;
		isolation: isolate;
	}

	.contact__bg {
		position: absolute;
		top: 2%;
		left: -4vw;
		z-index: -1;
		font-family: var(--font-hand);
		font-size: clamp(11rem, 42vw, 34rem);
		line-height: 1;
		color: var(--cherry-deep);
		rotate: -8deg;
		pointer-events: none;
		white-space: nowrap;
	}

	.contact .eyebrow {
		color: rgb(250 246 238 / 0.75);
	}

	.contact .eyebrow::before {
		color: var(--butter);
	}

	.contact__info {
		container-type: inline-size;
	}

	/* Limitado al ancho de su columna para que "increíble" no se salga */
	.contact__title {
		font-size: clamp(3rem, min(8.5vw, 21cqi), 6.4rem);
	}

	.contact__title :global(em) {
		color: var(--butter);
	}

	.contact__title :global(.scribble__svg path) {
		stroke: var(--pink);
	}

	.contact__tagline {
		margin-top: 22px;
		max-width: 46ch;
		font-size: 1.1rem;
		color: rgb(250 246 238 / 0.85);
	}

	.contact__links {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 32px;
	}

	.clink {
		flex-direction: column;
		align-items: flex-start;
		gap: 2px;
		padding: 0.7em 1.05em;
		transition:
			transform 0.4s var(--ease-pop),
			box-shadow 0.3s;
	}

	.clink:hover,
	.clink:focus-visible {
		transform: rotate(-3deg) scale(1.08);
		box-shadow: 5px 5px 0 var(--ink);
	}

	.clink__label {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.75;
	}

	.clink__value {
		font-size: 1rem;
		word-break: break-all;
	}

	.contact__avail {
		margin-top: 28px;
		font-size: 0.95rem;
		color: rgb(250 246 238 / 0.75);
	}

	/* Tarjeta del formulario */
	.contact__grid {
		display: grid;
		gap: 64px;
	}

	.fcard {
		position: relative;
		padding: 34px 22px 26px;
		border: var(--line);
		border-radius: var(--radius);
		background: var(--paper);
		color: var(--ink);
		box-shadow: 10px 10px 0 var(--cherry-deep);
	}

	.fcard__form {
		container: fcard / inline-size;
		display: grid;
		gap: 16px;
	}

	.fcard__bot {
		display: none;
	}

	.fcard__row {
		display: grid;
		gap: 16px;
	}

	/* Los dos selects van lado a lado solo si el formulario tiene ancho para sus etiquetas */
	@container fcard (min-width: 560px) {
		.fcard__row {
			grid-template-columns: 1fr 1fr;
		}
	}

	.field {
		position: relative;
		border-radius: 14px;
	}

	.field__input {
		display: block;
		width: 100%;
		padding: 26px 16px 10px;
		border: var(--line);
		border-radius: 14px;
		background: var(--cream);
		font-size: 1rem;
		line-height: 1.4;
		transition:
			box-shadow 0.3s var(--ease-pop),
			transform 0.3s var(--ease-pop),
			background-color 0.3s;
		appearance: none;
	}

	textarea.field__input {
		resize: vertical;
		min-height: 140px;
	}

	.field__input::placeholder {
		color: transparent;
		transition: color 0.2s;
	}

	.field__input:focus {
		outline: none;
		background: var(--paper);
		box-shadow: 5px 5px 0 var(--pink);
		transform: translate(-2px, -2px);
	}

	.field__input:focus::placeholder {
		color: rgb(91 79 79 / 0.6);
	}

	.field__label {
		position: absolute;
		left: 17px;
		top: 18px;
		font-weight: 600;
		color: var(--ink-soft);
		pointer-events: none;
		/* Una sola línea: el ancho se compensa por la escala (0.74) de la etiqueta flotante */
		max-width: calc((100% - 50px) / 0.74);
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		transform-origin: 0 0;
		transition:
			transform 0.4s var(--ease-pop),
			color 0.3s;
	}

	.field__input:focus + .field__label,
	.field__input:not(:placeholder-shown) + .field__label,
	.field--select .field__label {
		transform: translateY(-11px) scale(0.74);
		color: var(--cherry);
	}

	.field--select::after {
		content: '↓';
		position: absolute;
		right: 16px;
		top: 50%;
		translate: 0 -50%;
		font-weight: 800;
		pointer-events: none;
	}

	.field--select .field__input {
		padding-right: 40px;
		cursor: pointer;
	}

	.field:global(.is-flash) {
		animation: flash 1s var(--ease-pop);
	}

	.fcard__status {
		padding: 12px 14px;
		border: 2px solid var(--tomato);
		border-radius: 12px;
		background: rgb(229 72 47 / 0.08);
		color: var(--cherry-deep);
		font-weight: 600;
		font-size: 0.95rem;
	}

	.fcard__submit {
		width: 100%;
		margin-top: 4px;
		padding-block: 1.1em;
		font-size: 1.05rem;
	}

	.fcard__submit:disabled {
		cursor: progress;
		opacity: 0.85;
	}

	.fcard__submit:global(.is-shake) {
		animation: shake 0.5s var(--ease-out);
	}

	.fcard__privacy {
		font-size: 0.85rem;
		color: var(--ink-soft);
		text-align: center;
	}

	.fcard__success {
		display: grid;
		justify-items: center;
		gap: 14px;
		padding: 30px 6px 20px;
		text-align: center;
		outline: none;
	}

	.fcard__success[hidden] {
		display: none;
	}

	.fcard__check {
		--r: -6deg;
		display: grid;
		place-items: center;
		width: 96px;
		height: 96px;
		border: var(--line);
		border-radius: 50%;
		background: var(--butter);
		box-shadow: var(--shadow);
		font-size: 3rem;
		font-weight: 800;
		transform: rotate(var(--r));
		animation: pop-in 0.75s var(--ease-pop) backwards;
	}

	.fcard__success-title {
		font-family: var(--font-display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(2.2rem, 7vw, 3.2rem);
		line-height: 0.95;
		color: var(--cherry);
	}

	.fcard__success p {
		max-width: 38ch;
		color: var(--ink-soft);
	}

	/* Confeti (creado desde JS) */
	.fcard :global(.confetti) {
		position: absolute;
		width: 0;
		height: 0;
		z-index: 5;
		pointer-events: none;
	}

	.fcard :global(.confetti i) {
		position: absolute;
		left: 0;
		top: 0;
		border-radius: 2px;
		animation: confetti 1.5s var(--ease-out) forwards;
	}

	@media (min-width: 640px) {
		.fcard {
			padding: 42px 34px 30px;
		}
	}

	@media (min-width: 1024px) {
		.contact__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 72px;
			align-items: start;
		}

		.contact__info {
			position: sticky;
			top: calc(var(--header-h) + 32px);
		}
	}
</style>
