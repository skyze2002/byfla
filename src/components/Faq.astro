---
import { faqKeys, es } from '../data/site';

const tones = ['butter', 'pink', 'sky', 'paper', 'butter', 'pink'];
---

<section id="preguntas" class="section faq" aria-labelledby="faq-title">
	<div class="container faq__grid">
		<header class="faq__head">
			<p class="eyebrow" data-reveal="up"><span data-i18n="faq_eyebrow">{es('faq_eyebrow')}</span></p>
			<h2 id="faq-title" class="h-section" data-reveal="up">
				<span data-i18n="faq_h1">{es('faq_h1')}</span>{' '}
				<em data-i18n="faq_h2">{es('faq_h2')}</em>
			</h2>
			<p class="faq__note hand" data-reveal="pop" style="--r:-4deg;--d:0.3s" aria-hidden="true">¿dudas? ↘</p>
		</header>

		<ul class="faq__list" data-stagger="0.08">
			{
				faqKeys.map((k, i) => (
					<li data-reveal="up">
						<details class={`qa qa--${tones[i % tones.length]}`} open={i === 0}>
							<summary class="qa__q">
								<span data-i18n={`${k}_q`}>{es(`${k}_q`)}</span>
								<span class="qa__icon" aria-hidden="true">+</span>
							</summary>
							<p class="qa__a" data-i18n={`${k}_a`}>{es(`${k}_a`)}</p>
						</details>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.faq__grid {
		display: grid;
		gap: 40px;
	}

	.faq__head {
		container-type: inline-size;
	}

	.faq__head .h-section {
		font-size: clamp(3rem, min(9.5vw, 19cqi), 6.4rem);
	}

	.faq__note {
		display: inline-block;
		margin-top: 18px;
		font-size: 1.9rem;
		color: var(--tomato);
	}

	.faq__list {
		display: grid;
		gap: 14px;
	}

	.qa {
		--bg: var(--paper);
		border: var(--line);
		border-radius: var(--radius);
		background: var(--paper);
		box-shadow: var(--shadow);
		transition:
			box-shadow 0.3s var(--ease-pop),
			translate 0.3s var(--ease-pop),
			background-color 0.3s;
	}

	.qa--butter { --bg: var(--butter); }
	.qa--pink { --bg: var(--pink); }
	.qa--sky { --bg: var(--sky); }
	.qa--paper { --bg: var(--cream); }

	.qa:hover {
		translate: -2px -2px;
		box-shadow: var(--shadow-lg);
	}

	.qa[open] {
		background: var(--bg);
	}

	.qa__q {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 20px;
		font-weight: 700;
		font-size: 1.08rem;
		line-height: 1.3;
		cursor: pointer;
		list-style: none;
	}

	.qa__q::-webkit-details-marker {
		display: none;
	}

	.qa__q:focus-visible {
		outline: 3px solid var(--cherry);
		outline-offset: 4px;
		border-radius: var(--radius);
	}

	.qa__icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border: var(--line);
		border-radius: 50%;
		background: var(--paper);
		font-size: 1.4rem;
		line-height: 1;
		transition: rotate 0.4s var(--ease-pop);
	}

	.qa[open] .qa__icon {
		rotate: 45deg;
	}

	.qa__a {
		padding: 0 20px 20px;
		max-width: 62ch;
		color: var(--ink);
	}

	@media (min-width: 1024px) {
		.faq__grid {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
			gap: 72px;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: calc(var(--header-h) + 32px);
		}
	}
</style>
