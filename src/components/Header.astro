---
import { nav, contact, site, es } from '../data/site';
---

<div class="progress" data-progress aria-hidden="true"></div>

<header class="header" data-header>
	<div class="container header__row">
		<a href="#inicio" class="logo" data-i18n-aria="nav_home" aria-label={es('nav_home')}>
			<span class="logo__star" aria-hidden="true">✶</span>
			<span>{site.firstName}</span>
		</a>

		<nav class="header__nav" aria-label="Principal">
			<ul>
				{nav.map((n) => <li><a class="ulink" href={n.href} data-i18n={n.key}>{es(n.key)}</a></li>)}
			</ul>
		</nav>

		<div class="header__actions">
			<button class="lang-btn" type="button" data-lang="es" data-i18n-aria="lang_switch" aria-label={es('lang_switch')}>
				<span class="lang-es active">ES</span>
				<span class="lang-en">EN</span>
			</button>
			<a class="btn btn--butter btn--sm header__cta" href="#contacto" data-magnetic="0.3">
				<span data-i18n="cta_primary">{es('cta_primary')}</span>
				<span class="btn__arrow" aria-hidden="true">→</span>
			</a>
			<button
				id="menu-toggle"
				class="burger"
				type="button"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-i18n-aria="menu_open"
				aria-label={es('menu_open')}
			>
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>
</header>

<div id="mobile-menu" class="mmenu">
	<nav aria-label="Menú móvil">
		<ul class="mmenu__list">
			{
				nav.map((n, i) => (
					<li style={`--i:${i}`}>
						<a href={n.href} data-i18n={n.key}>{es(n.key)}</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="mmenu__foot" style={`--i:${nav.length}`}>
		<button class="lang-btn lang-btn--light" type="button" data-lang="es" data-i18n-aria="lang_switch" aria-label={es('lang_switch')}>
			<span class="lang-es active">ES</span>
			<span class="lang-en">EN</span>
		</button>
		<a class="mmenu__mail hand" href={`mailto:${contact.email}`}>{contact.email}</a>
	</div>
</div>

<style>
	/* Barra de progreso de lectura */
	.progress {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 120;
		height: 4px;
		background: linear-gradient(90deg, var(--pink), var(--tomato), var(--cherry));
		transform: scaleX(0);
		transform-origin: 0 50%;
		pointer-events: none;
	}

	.header {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		transition:
			transform 0.5s var(--ease-out),
			background-color 0.35s,
			box-shadow 0.35s;
	}

	.header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgb(250 246 238 / 0.78);
		backdrop-filter: blur(14px) saturate(1.3);
		-webkit-backdrop-filter: blur(14px) saturate(1.3);
		border-bottom: 2px solid rgb(26 20 20 / 0.08);
		opacity: 0;
		transition: opacity 0.35s;
	}

	.header:global(.is-scrolled)::before {
		opacity: 1;
	}

	.header:global(.is-hidden) {
		transform: translateY(-110%);
	}

	:global(.menu-open) .header {
		transform: none;
	}

	:global(.menu-open) .header::before {
		opacity: 0;
	}

	.header__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: var(--header-h);
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		font-family: var(--font-display);
		font-size: 1.7rem;
		letter-spacing: 0.04em;
		color: var(--cherry);
		transition: color 0.3s;
	}

	.logo__star {
		display: inline-block;
		color: var(--tomato);
		transition: transform 0.6s var(--ease-pop);
	}

	.logo:hover .logo__star {
		transform: rotate(180deg);
	}

	:global(.menu-open) .logo {
		color: var(--butter);
	}

	.header__nav {
		display: none;
	}

	.header__nav ul {
		display: flex;
		gap: 2rem;
	}

	.ulink {
		position: relative;
		font-weight: 600;
		padding-block: 0.2em;
	}

	.ulink::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 3px;
		border-radius: 3px;
		background: var(--tomato);
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition: transform 0.4s var(--ease-out);
	}

	.ulink:hover::after,
	.ulink:focus-visible::after {
		transform: scaleX(1);
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.header__cta {
		display: none;
	}

	/* Switch ES | EN tipo píldora */
	.lang-btn {
		position: relative;
		display: inline-flex;
		padding: 3px;
		border: var(--line);
		border-radius: 999px;
		background: var(--paper);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		box-shadow: 2px 2px 0 var(--ink);
	}

	.lang-btn::before {
		content: '';
		position: absolute;
		top: 3px;
		bottom: 3px;
		left: 3px;
		width: calc(50% - 3px);
		border-radius: 999px;
		background: var(--cherry);
		transition: transform 0.45s var(--ease-pop);
	}

	.lang-btn[data-lang='en']::before {
		transform: translateX(100%);
	}

	.lang-btn span {
		position: relative;
		z-index: 1;
		width: 2.4em;
		padding: 0.35em 0;
		text-align: center;
		transition: color 0.3s;
	}

	.lang-btn span:global(.active) {
		color: var(--cream);
	}

	/* Burger → X */
	.burger {
		position: relative;
		width: 46px;
		height: 46px;
		border: var(--line);
		border-radius: 50%;
		background: var(--butter);
		box-shadow: 2px 2px 0 var(--ink);
	}

	.burger span {
		position: absolute;
		left: 12px;
		right: 12px;
		height: 2.5px;
		border-radius: 2px;
		background: var(--ink);
		transition:
			transform 0.45s var(--ease-pop),
			opacity 0.25s;
	}

	.burger span:nth-child(1) { top: 15px; }
	.burger span:nth-child(2) { top: 21px; }
	.burger span:nth-child(3) { top: 27px; }

	.burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
	.burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
	.burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

	/* Menú móvil */
	.mmenu {
		position: fixed;
		inset: 0;
		z-index: 90;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 2.5rem;
		padding: calc(var(--header-h) + 1rem) var(--gutter) 2rem;
		background: var(--cherry);
		color: var(--cream);
		clip-path: circle(0px at var(--cx, 90%) var(--cy, 36px));
		visibility: hidden;
		transition:
			clip-path 0.7s var(--ease-io),
			visibility 0s linear 0.7s;
	}

	.mmenu:global(.is-open) {
		clip-path: circle(150vmax at var(--cx, 90%) var(--cy, 36px));
		visibility: visible;
		transition: clip-path 0.7s var(--ease-io);
	}

	.mmenu__list li,
	.mmenu__foot {
		transform: translateY(60px) rotate(-4deg);
		opacity: 0;
		transition:
			transform 0.6s var(--ease-pop),
			opacity 0.4s;
	}

	.mmenu:global(.is-open) .mmenu__list li,
	.mmenu:global(.is-open) .mmenu__foot {
		transform: none;
		opacity: 1;
		transition-delay: calc(0.18s + var(--i) * 70ms);
	}

	.mmenu__list a {
		display: inline-block;
		font-family: var(--font-display);
		text-transform: uppercase;
		font-size: clamp(3.2rem, 15vw, 6rem);
		line-height: 1;
		transition:
			color 0.3s,
			transform 0.4s var(--ease-pop);
	}

	.mmenu__list a:hover,
	.mmenu__list a:focus-visible {
		color: var(--butter);
		transform: translateX(10px) rotate(-2deg);
	}

	.mmenu__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
	}

	.mmenu__mail {
		font-size: 1.5rem;
		color: var(--pink);
		word-break: break-all;
	}

	.lang-btn--light span {
		color: var(--ink);
	}

	@media (min-width: 960px) {
		.header__nav,
		.header__cta {
			display: inline-flex;
		}

		.burger,
		.mmenu {
			display: none;
		}
	}
</style>
