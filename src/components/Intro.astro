---
import { site, es } from '../data/site';
---

<div class="intro" aria-hidden="true">
	<div class="intro__stage">
		<p class="intro__word">
			{[...site.introWord].map((c, i) => <span class="intro__mask"><span style={`--i:${i}`}>{c}</span></span>)}
		</p>
		<span class="intro__hi" data-i18n="intro_hi">{es('intro_hi')}</span>
		<span class="intro__star">✶</span>
	</div>
	<p class="intro__hint"><span data-i18n="intro_scroll">{es('intro_scroll')}</span> <span class="intro__arrow">↓</span></p>
</div>

<style>
	.intro {
		display: none;
	}

	:global(.intro-on) body {
		overflow: hidden;
	}

	:global(.intro-on) .intro {
		display: grid;
		place-items: center;
		position: fixed;
		inset: 0;
		z-index: 10001;
		background: var(--cherry);
		color: var(--butter);
		clip-path: inset(0 0 0 0);
		transition: clip-path 0.85s var(--ease-io);
		cursor: pointer;
	}

	.intro:global(.intro--out) {
		clip-path: inset(0 0 100% 0);
	}

	.intro__stage {
		position: relative;
	}

	.intro__word {
		display: flex;
		font-family: var(--font-display);
		font-size: clamp(9rem, 38vw, 26rem);
		line-height: 0.85;
	}

	.intro__mask {
		display: inline-block;
		overflow: hidden;
		padding-top: 0.04em;
	}

	.intro__mask > span {
		display: inline-block;
		transform: translateY(110%);
		animation: rise 0.7s var(--ease-pop) calc(0.1s + var(--i) * 80ms) forwards;
	}

	.intro__hi {
		--r: -12deg;
		position: absolute;
		right: -0.4em;
		top: -0.35em;
		font-family: var(--font-hand);
		font-size: clamp(2.6rem, 9vw, 5.5rem);
		color: var(--pink);
		animation: pop-in 0.75s var(--ease-pop) 0.45s backwards;
		transform: rotate(var(--r));
	}

	.intro__hint {
		position: absolute;
		left: 50%;
		bottom: max(28px, env(safe-area-inset-bottom));
		translate: -50% 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		font-family: var(--font-hand);
		font-size: clamp(1.4rem, 4vw, 1.9rem);
		color: var(--pink);
		white-space: nowrap;
		animation: fade-in 0.6s var(--ease-out) 1.1s backwards;
	}

	.intro__arrow {
		display: inline-block;
		font-size: 1.4em;
		line-height: 1;
		animation: bob 1.6s ease-in-out infinite;
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}

	.intro__star {
		position: absolute;
		left: -0.5em;
		bottom: 0.1em;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		color: var(--pink);
		animation: spin 3.5s linear infinite;
	}
</style>
