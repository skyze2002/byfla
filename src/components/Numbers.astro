---
import { metricCards, audience, compact, es } from '../data/site';
import Scribble from './Scribble.astro';

const tileRot = [-2, 1.5, -1, 2.5];
const groups = [
	{ titleKey: 'stats_demo_tiktok', rows: audience.ageTiktok.map((a) => ({ label: a.range, pct: a.pct })) },
	{ titleKey: 'stats_demo_ig', rows: audience.ageInstagram.map((a) => ({ label: a.range, pct: a.pct })) },
	{ titleKey: 'stats_geo', rows: audience.geo.map((g) => ({ label: es(g.key), key: g.key, flag: g.flag, pct: g.pct })) },
];
---

<section class="section numbers" aria-labelledby="numbers-title">
	<div class="numbers__star-wrap" data-parallax="0.3" aria-hidden="true"><span class="numbers__star">✶</span></div>

	<div class="container">
		<header class="numbers__head">
			<p class="eyebrow" data-reveal="up"><span data-i18n="stats_eyebrow">{es('stats_eyebrow')}</span></p>
			<h2 id="numbers-title" class="h-section" data-reveal="up">
				<span data-i18n="stats_h1">{es('stats_h1')}</span>{' '}
				<em data-i18n="stats_h2">{es('stats_h2')}</em>{' '}
				<Scribble k="stats_h3" d="0.5s" />
			</h2>
		</header>

		<ul class="numbers__tiles" data-stagger="0.12">
			{
				metricCards.map((m, i) => (
					<li
						class={`tile tile--${m.tone}`}
						data-reveal="tilt"
						data-tilt="12"
						style={`--r:${tileRot[i]}deg;--tilt:${tileRot[i] * 4 - 4}deg`}
					>
						<span class="tile__sub">{m.sub}</span>
						<strong class="tile__num" data-count={m.value} data-format={m.format} data-suffix={m.suffix}>
							{(m.format === 'compact' ? compact(m.value) : m.value) + m.suffix}
						</strong>
						<span class="tile__label" data-i18n={m.labelKey}>{es(m.labelKey)}</span>
					</li>
				))
			}
		</ul>

		<div class="numbers__bars">
			{
				groups.map((g, gi) => (
					<div class="bars" data-reveal="up" style={`--d:${gi * 0.12}s`}>
						<h3 class="bars__title" data-i18n={g.titleKey}>{es(g.titleKey)}</h3>
						<ul>
							{g.rows.map((row, i) => (
								<li class="bar">
									<span class="bar__label">
										{'flag' in row && <span aria-hidden="true">{row.flag} </span>}
										{'key' in row ? <span data-i18n={row.key}>{row.label}</span> : row.label}
									</span>
									<span class="bar__track">
										<span class="bar__fill" style={`--w:${row.pct}%;--bd:${(i * 0.15).toFixed(2)}s`} />
									</span>
									<span class="bar__val">{row.pct}%</span>
								</li>
							))}
						</ul>
						{gi === 2 && (
							<span class="numbers__note" data-reveal="pop" style="--r:-6deg;--d:0.9s" data-i18n="stats_note">
								{es('stats_note')}
							</span>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.numbers {
		background: var(--leaf);
		color: var(--cream);
		overflow: hidden;
		isolation: isolate;
	}

	.numbers .eyebrow {
		color: rgb(250 246 238 / 0.75);
	}

	.numbers .h-section :global(em) {
		color: var(--butter);
	}

	.numbers__star-wrap {
		position: absolute;
		top: 6%;
		right: -14vw;
		z-index: -1;
		pointer-events: none;
	}

	.numbers__star {
		display: block;
		font-size: clamp(22rem, 60vw, 48rem);
		line-height: 1;
		color: rgb(250 246 238 / 0.07);
		animation: spin 40s linear infinite;
	}

	.numbers__tiles {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		margin-top: 56px;
	}

	.tile {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 22px 18px;
		min-height: 190px;
		border: var(--line);
		border-radius: var(--radius);
		background: var(--paper);
		color: var(--ink);
		box-shadow: var(--shadow);
	}

	.tile:hover {
		box-shadow: 10px 10px 0 var(--ink);
	}

	.tile--pink { background: var(--pink); }
	.tile--sky { background: var(--sky); }
	.tile--butter { background: var(--butter); }
	.tile--tomato { background: var(--tomato); color: var(--paper); }

	.tile__sub {
		font-size: 0.82rem;
		font-weight: 700;
		opacity: 0.8;
	}

	.tile__num {
		margin-top: auto;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(3rem, 11vw, 5.6rem);
		line-height: 0.9;
	}

	.tile__label {
		font-weight: 700;
		line-height: 1.2;
	}

	.numbers__bars {
		display: grid;
		gap: 20px;
		margin-top: 48px;
	}

	.bars {
		position: relative;
		padding: 24px 22px 26px;
		border: 2px solid rgb(250 246 238 / 0.85);
		border-radius: var(--radius);
		background: rgb(26 20 20 / 0.14);
	}

	.bars__title {
		font-size: 1rem;
		font-weight: 700;
		margin-bottom: 16px;
	}

	.bars ul {
		display: grid;
		gap: 14px;
	}

	.bar {
		display: grid;
		grid-template-columns: 6.4em 1fr 3.6em;
		align-items: center;
		gap: 12px;
		font-size: 0.92rem;
	}

	.bar__track {
		height: 14px;
		border: 2px solid var(--cream);
		border-radius: 999px;
		overflow: hidden;
	}

	.bar__fill {
		display: block;
		height: 100%;
		width: var(--w);
		border-radius: inherit;
		background: var(--butter);
		transition: width 1.4s var(--ease-out) calc(var(--d) + 0.2s + var(--bd));
	}

	.bars:nth-child(2) .bar__fill { background: var(--pink); }
	.bars:nth-child(3) .bar__fill { background: var(--sky); }

	:global(.js) .bars:not(:global(.in)) .bar__fill {
		width: 0;
	}

	.bar__val {
		font-weight: 700;
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.numbers__note {
		position: absolute;
		right: 14px;
		top: -22px;
		display: inline-block;
		font-family: var(--font-hand);
		font-size: 1.9rem;
		color: var(--butter);
		transform: rotate(var(--r));
	}

	@media (min-width: 900px) {
		.numbers__tiles {
			grid-template-columns: repeat(4, 1fr);
			gap: 22px;
		}

		.tile {
			min-height: 240px;
			padding: 26px 22px;
		}

		.numbers__bars {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
